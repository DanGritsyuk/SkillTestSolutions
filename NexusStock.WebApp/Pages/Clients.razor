@page "/clients/{Tab:int}"
@using NexusStock.WebApp.BLL.Services.Contracts
@using NexusStock.WebApp.Common.Entities.Client
@inject IClientsService ClientsService
@inject NavigationManager Navigation

<PageTitle>Клиенты</PageTitle>

<h3>Клиенты</h3>

<div class="d-flex justify-content-between mb-3">
    <div>
        <button class="btn btn-primary" @onclick="ShowCreateForm">
            <i class="bi bi-plus-circle"></i> Создать
        </button>
    </div>

    <ul class="nav nav-pills">
        <li class="nav-item">
            <NavLink class="@GetNavClass(1)" href="/clients/1">
                Активные
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="@GetNavClass(2)" href="/clients/2">
                Архивные
            </NavLink>
        </li>
    </ul>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (clients.Count == 0)
{
    <div class="alert alert-info">
        @(Tab == 1
            ? "Нет активных клиентов"
            : "Нет архивных клиентов")
</div>
}
else
{
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Наименование</th>
                <th>Адрес</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in clients)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.Name</td>
                    <td>@client.Address</td>
                    <td>
                        @if (client.IsActive)
                        {
                            <span class="badge bg-success">Активен</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Архив</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => EditClient(client)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger ms-1"
                                @onclick="() => ToggleStatus(client)">
                            @(client.IsActive ? "В архив" : "Активировать")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showForm)
{
    <div class="modal" style="display:block; background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(isEditing ? "Редактирование" : "Создание") клиента
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentClient" OnValidSubmit="@SaveClient">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Наименование *</label>
                            <InputText class="form-control" @bind-Value="currentClient.Name" />
                            <ValidationMessage For="@(() => currentClient.Name)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Адрес *</label>
                            <InputText class="form-control" @bind-Value="currentClient.Address" />
                            <ValidationMessage For="@(() => currentClient.Address)" />
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="button" class="btn btn-secondary me-2"
                                    @onclick="CloseForm">
                                Отмена
                            </button>
                            <button type="submit" class="btn btn-primary">
                                Сохранить
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Tab { get; set; } = 1; // 1 - активные, 2 - архивные

    private List<ClientResponse> clients = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditing = false;
    private ClientCreateRequest currentClient = new();
    private int currentId;

    private string GetNavClass(int tab)
    {
        return Tab == tab ? "nav-link active" : "nav-link";
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadClients();
    }

    private async Task LoadClients()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Для активных - только активные записи
            if (Tab == 1)
            {
                clients = (await ClientsService.GetClientsAsync(false))?.ToList()
                    ?? new List<ClientResponse>();
            }
            // Для архивных - только архивные записи
            else
            {
                var allClients = await ClientsService.GetClientsAsync(true);
                clients = allClients?.Where(c => !c.IsActive).ToList()
                    ?? new List<ClientResponse>();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateForm()
    {
        currentClient = new ClientCreateRequest();
        isEditing = false;
        showForm = true;
    }

    private void EditClient(ClientResponse client)
    {
        currentClient = new ClientCreateRequest
        {
            Name = client.Name,
            Address = client.Address
        };
        currentId = client.Id;
        isEditing = true;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task SaveClient()
    {
        try
        {
            if (isEditing)
            {
                await ClientsService.UpdateClientAsync(new ClientUpdateRequest
                {
                    Id = currentId,
                    Name = currentClient.Name,
                    Address = currentClient.Address
                });
            }
            else
            {
                await ClientsService.CreateClientAsync(currentClient);
            }

            showForm = false;
            await LoadClients();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }

    private async Task ToggleStatus(ClientResponse client)
    {
        try
        {
            await ClientsService.ToggleClientStatusAsync(client.Id);
            await LoadClients();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }
}
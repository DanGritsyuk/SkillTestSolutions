@page "/units/{Tab:int}"
@using NexusStock.WebApp.BLL.Services.Contracts
@using NexusStock.WebApp.Common.Entities.Unit
@inject IUnitsService UnitsService
@inject NavigationManager Navigation

<PageTitle>Единицы измерения</PageTitle>

<h3>Единицы измерения</h3>

<div class="d-flex justify-content-between mb-3">
    <div>
        <button class="btn btn-primary" @onclick="ShowCreateForm">
            <i class="bi bi-plus-circle"></i> Создать
        </button>
    </div>

    <ul class="nav nav-pills">
        <li class="nav-item">
            <NavLink class="@GetNavClass(1)" href="/units/1">
                Активные
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="@GetNavClass(2)" href="/units/2">
                Архивные
            </NavLink>
        </li>
    </ul>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (units.Count == 0)
{
    <div class="alert alert-info">
        @(IsActiveTab(1)
            ? "Нет активных единиц измерения"
            : "Нет архивных единиц измерения")
</div>
}
else
{
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Наименование</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in units)
            {
                <tr>
                    <td>@unit.Id</td>
                    <td>@unit.Name</td>
                    <td>
                        @if (unit.IsActive)
                        {
                            <span class="badge bg-success">Активна</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Архив</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => EditUnit(unit)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger ms-1"
                                @onclick="() => ToggleStatus(unit)">
                            @(unit.IsActive ? "В архив" : "Активировать")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showForm)
{
    <div class="modal" style="display:block; background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(isEditing ? "Редактирование" : "Создание") единицы измерения
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentUnit" OnValidSubmit="@SaveUnit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Наименование *</label>
                            <InputText class="form-control" @bind-Value="currentUnit.Name" />
                            <ValidationMessage For="@(() => currentUnit.Name)" />
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="button" class="btn btn-secondary me-2"
                                    @onclick="CloseForm">
                                Отмена
                            </button>
                            <button type="submit" class="btn btn-primary">
                                Сохранить
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Tab { get; set; } = 1; // 1 - активные, 2 - архивные

    private List<UnitResponse> units = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditing = false;
    private UnitCreateRequest currentUnit = new();
    private int currentId;

    private bool IsActiveTab(int tab) => Tab == tab;

    protected override async Task OnParametersSetAsync()
    {
        await LoadUnits();
    }

    private string GetNavClass(int tab)
    {
        return Tab == tab ? "nav-link active" : "nav-link";
    }

    private async Task LoadUnits()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Для активных - только активные записи
            if (Tab == 1)
            {
                units = (await UnitsService.GetUnitsAsync())?.ToList()
                    ?? new List<UnitResponse>();
            }
            // Для архивных - только архивные записи
            else
            {
                var allUnits = await UnitsService.GetUnitsAsync(true);
                units = allUnits?.Where(u => !u.IsActive).ToList()
                    ?? new List<UnitResponse>();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateForm()
    {
        currentUnit = new UnitCreateRequest();
        isEditing = false;
        showForm = true;
    }

    private void EditUnit(UnitResponse unit)
    {
        currentUnit = new UnitCreateRequest { Name = unit.Name };
        currentId = unit.Id;
        isEditing = true;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task SaveUnit()
    {
        try
        {
            if (isEditing)
            {
                await UnitsService.UpdateUnitAsync(new UnitUpdateRequest
                {
                    Id = currentId,
                    Name = currentUnit.Name
                });
            }
            else
            {
                await UnitsService.CreateUnitAsync(currentUnit);
            }

            showForm = false;
            await LoadUnits();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }

    private async Task ToggleStatus(UnitResponse unit)
    {
        try
        {
            await UnitsService.ToggleUnitStatusAsync(unit.Id);
            await LoadUnits();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }
}
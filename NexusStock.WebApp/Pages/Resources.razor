@page "/resources/{Tab:int}"
@using NexusStock.WebApp.BLL.Services.Contracts
@using NexusStock.WebApp.Common.Entities.Resources
@inject IResourcesService ResourcesService
@inject NavigationManager Navigation

<PageTitle>Ресурсы</PageTitle>

<h3>Ресурсы</h3>

<div class="d-flex justify-content-between mb-3">
    <div>
        <button class="btn btn-primary" @onclick="ShowCreateForm">
            <i class="bi bi-plus-circle"></i> Создать
        </button>
    </div>

    <ul class="nav nav-pills">
        <li class="nav-item">
            <NavLink class="@GetNavClass(1)" href="/resources/1">
                Активные
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="@GetNavClass(2)" href="/resources/2">
                Архивные
            </NavLink>
        </li>
    </ul>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (resources.Count == 0)
{
    <div class="alert alert-info">
        @(Tab == 1
            ? "Нет активных ресурсов"
            : "Нет архивных ресурсов")
</div>
}
else
{
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Наименование</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var resource in resources)
            {
                <tr>
                    <td>@resource.Id</td>
                    <td>@resource.Name</td>
                    <td>
                        @if (resource.IsActive)
                        {
                            <span class="badge bg-success">Активен</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Архив</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => EditResource(resource)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger ms-1"
                                @onclick="() => ToggleStatus(resource)">
                            @(resource.IsActive ? "В архив" : "Активировать")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showForm)
{
    <div class="modal" style="display:block; background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(isEditing ? "Редактирование" : "Создание") ресурса
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentResource" OnValidSubmit="@SaveResource">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Наименование *</label>
                            <InputText class="form-control" @bind-Value="currentResource.Name" />
                            <ValidationMessage For="@(() => currentResource.Name)" />
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="button" class="btn btn-secondary me-2"
                                    @onclick="CloseForm">
                                Отмена
                            </button>
                            <button type="submit" class="btn btn-primary">
                                Сохранить
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Tab { get; set; } = 1; // 1 - активные, 2 - архивные

    private List<ResourceResponse> resources = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditing = false;
    private ResourceCreateRequest currentResource = new();
    private int currentId;

    private string GetNavClass(int tab)
    {
        return Tab == tab ? "nav-link active" : "nav-link";
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadResources();
    }

    private async Task LoadResources()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Для активных - только активные записи
            if (Tab == 1)
            {
                resources = (await ResourcesService.GetResourcesAsync(false))?.ToList()
                    ?? new List<ResourceResponse>();
            }
            // Для архивных - только архивные записи
            else
            {
                var allResources = await ResourcesService.GetResourcesAsync(true);
                resources = allResources?.Where(r => !r.IsActive).ToList()
                    ?? new List<ResourceResponse>();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateForm()
    {
        currentResource = new ResourceCreateRequest();
        isEditing = false;
        showForm = true;
    }

    private void EditResource(ResourceResponse resource)
    {
        currentResource = new ResourceCreateRequest { Name = resource.Name };
        currentId = resource.Id;
        isEditing = true;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task SaveResource()
    {
        try
        {
            if (isEditing)
            {
                await ResourcesService.UpdateResourceAsync(new ResourceUpdateRequest
                {
                    Id = currentId,
                    Name = currentResource.Name
                });
            }
            else
            {
                await ResourcesService.CreateResourceAsync(currentResource);
            }

            showForm = false;
            await LoadResources();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }

    private async Task ToggleStatus(ResourceResponse resource)
    {
        try
        {
            await ResourcesService.ToggleResourceStatusAsync(resource.Id);
            await LoadResources();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }
}
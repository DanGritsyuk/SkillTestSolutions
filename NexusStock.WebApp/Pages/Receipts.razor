@page "/receipts"
@using NexusStock.WebApp.BLL.Services.Contracts
@using NexusStock.WebApp.Common.Entities.Receipt
@using NexusStock.WebApp.Common.Entities.Resources
@using NexusStock.WebApp.Common.Entities.Unit
@inject IReceiptsService ReceiptsService
@inject IResourcesService ResourcesService
@inject IUnitsService UnitsService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Поступления</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Документы поступления</h3>
    <button class="btn btn-primary" @onclick="ShowCreateForm">
        <i class="bi bi-plus-circle me-1"></i> Создать
    </button>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <button class="btn btn-link text-decoration-none w-100 text-start d-flex justify-content-between align-items-center"
                @onclick="ToggleFilterPanel">
            <span class="fw-bold">Фильтры</span>
            <i class="bi bi-chevron-@(showFilters ? "up" : "down")"></i>
        </button>
    </div>

    @if (showFilters)
    {
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Дата с</label>
                        <InputDate class="form-control" @bind-Value="filter.StartDate" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Дата по</label>
                        <InputDate class="form-control" @bind-Value="filter.EndDate" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Ресурсы</label>
                        <select class="form-select" multiple size="3" @onchange="OnResourceFilterChange">
                            @if (allResources?.Count > 0)
                            {
                                @foreach (var resource in allResources)
                                {
                                    <option value="@resource.Id" selected="@selectedResourceIds.Contains(resource.Id)">
                                        @resource.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Единицы измерения</label>
                        <select class="form-select" multiple size="3" @onchange="OnUnitFilterChange">
                            @if (allUnits?.Count > 0)
                            {
                                @foreach (var unit in allUnits)
                                {
                                    <option value="@unit.Id" selected="@selectedUnitIds.Contains(unit.Id)">
                                        @unit.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end">
                <button class="btn btn-outline-secondary me-2" @onclick="ResetFilters">
                    <i class="bi bi-x-lg me-1"></i> Сбросить
                </button>
                <button class="btn btn-primary" @onclick="ApplyFilters">
                    <i class="bi bi-filter me-1"></i> Применить
                </button>
            </div>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (stockReceipts.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i> Нет документов поступления
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%">Номер</th>
                        <th style="width: 15%">Дата</th>
                        <th style="width: 45%">Ресурсы</th>
                        <th style="width: 15%">Общее количество</th>
                        <th style="width: 10%">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var receipt in stockReceipts)
                    {
                        <tr>
                            <td>@receipt.Number</td>
                            <td>@receipt.Date.LocalDateTime.ToString("dd.MM.yyyy")</td>
                            <td>
                                <button class="btn btn-link p-0 text-decoration-none"
                                        @onclick="() => ToggleDetails(receipt.Id)">
                                    @if (expandedReceipts.Contains(receipt.Id))
                                    {
                                        <i class="bi bi-chevron-down me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-chevron-right me-1"></i>
                                    }
                                    Показать товары (@receipt.Items.Count)
                                </button>
                            </td>
                            <td>@receipt.Items.Sum(i => i.Quantity).ToString("N2")</td>
                            <td>
                                <div class="d-flex">
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            @onclick="() => EditReceipt(receipt)"
                                            title="Редактировать">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteReceipt(receipt)"
                                            title="Удалить">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        @if (expandedReceipts.Contains(receipt.Id))
                        {
                            <tr class="bg-light">
                                <td colspan="5">
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>Ресурс</th>
                                                <th>Единица измерения</th>
                                                <th>Количество</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in receipt.Items)
                                            {
                                                <tr>
                                                    <td>@item.ResourceName</td>
                                                    <td>@item.UnitName</td>
                                                    <td>@item.Quantity.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (showForm)
{
    <div class="modal fade show" style="display:block; background:rgba(0,0,0,0.5)" @onclick="CloseForm">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(isEditing ? "Редактирование документа" : "Создание документа")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentReceipt" OnValidSubmit="@SaveReceipt">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Номер документа *</label>
                                <InputText class="form-control" @bind-Value="currentReceipt.Number" />
                                <ValidationMessage For="@(() => currentReceipt.Number)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Дата *</label>
                                <InputDate class="form-control" @bind-Value="currentReceipt.Date" />
                                <ValidationMessage For="@(() => currentReceipt.Date)" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Товары</h5>
                            <button type="button" class="btn btn-sm btn-success" @onclick="AddReceiptItem">
                                <i class="bi bi-plus-circle me-1"></i> Добавить товар
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40%">Ресурс *</th>
                                        <th style="width: 30%">Единица измерения *</th>
                                        <th style="width: 20%">Количество *</th>
                                        <th style="width: 10%"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < currentReceipt.Items.Count; i++)
                                    {
                                        var item = currentReceipt.Items[i];
                                        <tr>
                                            <td>
                                                <select class="form-select" @bind="item.ResourceId">
                                                    <option value="">Выберите ресурс</option>
                                                    @foreach (var resource in allResources)
                                                    {
                                                        <option value="@resource.Id">@resource.Name</option>
                                                    }
                                                </select>
                                                <ValidationMessage For="@(() => item.ResourceId)" />
                                            </td>
                                            <td>
                                                <select class="form-select" @bind="item.UnitId">
                                                    <option value="">Выберите единицу</option>
                                                    @foreach (var unit in allUnits)
                                                    {
                                                        <option value="@unit.Id">@unit.Name</option>
                                                    }
                                                </select>
                                                <ValidationMessage For="@(() => item.UnitId)" />
                                            </td>
                                            <td>
                                                <InputNumber class="form-control" @bind-Value="item.Quantity" />
                                                <ValidationMessage For="@(() => item.Quantity)" />
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-danger"
                                                        @onclick="() => RemoveReceiptItem(i)"
                                                        title="Удалить">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="button" class="btn btn-secondary me-2"
                                    @onclick="CloseForm">
                                <i class="bi bi-x-lg me-1"></i> Отмена
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Сохранить
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ReceiptResponse> stockReceipts = new();
    private List<ResourceResponse> allResources = new();
    private List<UnitResponse> allUnits = new();
    private List<int> selectedResourceIds = new();
    private List<int> selectedUnitIds = new();
    private HashSet<int> expandedReceipts = new();
    private ReceiptFilterRequest filter = new();
    private bool isLoading = true;
    private bool showFilters = true;
    private bool showForm = false;
    private bool isEditing = false;
    private ReceiptCreateRequest currentReceipt = new();
    private int currentId;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
        await LoadReceipts();
    }

    private async Task LoadInitialData()
    {
        allResources = (await ResourcesService.GetResourcesAsync(false))?.ToList() ?? new();
        allUnits = (await UnitsService.GetUnitsAsync(false))?.ToList() ?? new();
    }

    private async Task LoadReceipts()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Преобразование фильтров для API
            filter.ResourceIds = selectedResourceIds;
            filter.UnitIds = selectedUnitIds;

            stockReceipts = (await ReceiptsService.GetFilteredReceiptsAsync(filter))?.ToList() ?? new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleDetails(int receiptId)
    {
        if (expandedReceipts.Contains(receiptId))
        {
            expandedReceipts.Remove(receiptId);
        }
        else
        {
            expandedReceipts.Add(receiptId);
        }
    }

    private void ShowCreateForm()
    {
        currentReceipt = new ReceiptCreateRequest
        {
            Date = DateTimeOffset.Now,
            Items = new List<ReceiptItemRequest>()
        };
        isEditing = false;
        showForm = true;
    }

    private void EditReceipt(ReceiptResponse receipt)
    {
        currentReceipt = new ReceiptCreateRequest
        {
            Number = receipt.Number,
            Date = receipt.Date,
            Items = receipt.Items.Select(i => new ReceiptItemRequest
            {
                ResourceId = i.ResourceId,
                UnitId = i.UnitId,
                Quantity = i.Quantity
            }).ToList()
        };
        currentId = receipt.Id;
        isEditing = true;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private void AddReceiptItem()
    {
        currentReceipt.Items.Add(new ReceiptItemRequest());
    }

    private void RemoveReceiptItem(int index)
    {
        if (currentReceipt.Items.Count > index)
        {
            currentReceipt.Items.RemoveAt(index);
        }
    }

    private async Task SaveReceipt()
    {
        try
        {
            if (isEditing)
            {
                await ReceiptsService.UpdateReceiptAsync(new ReceiptUpdateRequest
                {
                    Id = currentId,
                    Number = currentReceipt.Number,
                    Date = currentReceipt.Date,
                    Items = currentReceipt.Items
                });
            }
            else
            {
                await ReceiptsService.CreateReceiptAsync(currentReceipt);
            }

            showForm = false;
            await LoadReceipts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }

    private async Task DeleteReceipt(ReceiptResponse receipt)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить документ {receipt.Number}?"))
        {
            await ReceiptsService.DeleteReceiptAsync(receipt.Id);
            await LoadReceipts();
        }
    }

    private void ToggleFilterPanel()
    {
        showFilters = !showFilters;
    }

    private void OnResourceFilterChange(ChangeEventArgs e)
    {
        var selected = e.Value as string[];
        selectedResourceIds = selected?.Select(int.Parse).ToList() ?? new List<int>();
    }

    private void OnUnitFilterChange(ChangeEventArgs e)
    {
        var selected = e.Value as string[];
        selectedUnitIds = selected?.Select(int.Parse).ToList() ?? new List<int>();
    }

    private async Task ApplyFilters()
    {
        await LoadReceipts();
    }

    private async Task ResetFilters()
    {
        selectedResourceIds = new List<int>();
        selectedUnitIds = new List<int>();
        filter = new ReceiptFilterRequest();
        await LoadReceipts();
    }
}